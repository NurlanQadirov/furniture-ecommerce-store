[Unit]
Description=Mebeltech storefront + admin panel (Next.js)
After=network.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/srv/apps/mebeltech
EnvironmentFile=/srv/apps/mebeltech/.env
Environment=NODE_ENV=production
# Only nginx talks to the app, so bind the loopback and keep the port off the
# public interface even if ufw were ever opened wider.
ExecStart=/usr/bin/npm start -- --hostname 127.0.0.1 --port 3004
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mebeltech

# Təhlükəsizlik
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
# The panel writes data/store.json and public/uploads/ at runtime.
ReadWritePaths=/srv/apps/mebeltech

[Install]
WantedBy=multi-user.target
