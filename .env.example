# Admin panel sign-in (/admin). Change both before going live.
ADMIN_EMAIL=admin@mebeltech.az
ADMIN_PASSWORD=mebeltech2024

# Optional: the key the session cookie is signed with. When left unset it is
# derived from ADMIN_PASSWORD, which means changing the password also signs
# everyone out. Set it explicitly to keep sessions across password changes.
ADMIN_SECRET=

# The public origin of the site, used for canonical URLs, the hreflang cluster,
# JSON-LD @id values, OpenGraph images, robots.txt and sitemap.xml. Set this
# before going live: without it everything above is emitted against the
# fallback https://mebeltech.az, which is wrong on any other domain.
NEXT_PUBLIC_SITE_URL=https://mebeltech.az
